// Run with:
//   cargo run -- examples/screw_detection_maple_full.dsrv \
//               --input-config examples/screw_detection_maple_input.json5 \
//               --redis-output
//
//   Also run in a separate terminal:
//   bash scripts/heartbeat_t.sh
//
// ===========================================================================
// FULL TRUSTWORTHINESS SPECIFICATION for the MAPLE-K screw-detection loop.
//
// Checks all 15 properties (P1-P15) from the original spec.
// Extends the events-only spec (screw_detection_maple.dsrv) by adding the
// nine knowledge-state inputs now readable via the redis-knowledge source.
//
// INPUT SOURCES (configured in screw_detection_maple_input.json5):
//   redis          - 8 pub/sub event channels (same as events-only spec)
//   redis-knowledge - 9 Redis keys written by rpclpy's KnowledgeManager
//
// EVENT INPUT FORMAT (pub/sub):
//   Each channel carries a JSON object: {"uid": "<uuid>", "timestamp": "..."}
//   plus any extra fields (e.g. sensor_data_received also carries detection_type).
//   Declared as Struct<uid: Str, ...> so the Map value is accepted without panic.
//   Boolean "fired this tick" is derived from uid comparison (see AUX section).
//
// KNOWLEDGE INPUT FORMAT (Redis keys):
//   rpclpy's write_knowledge_as_object() stores JSON objects in Redis keys.
//   Each value includes the domain fields plus uid/timestamp stamps added by
//   node.py at write time. Declared as Struct<field: Type, ...> with trailing
//   ... to accept those extra fields.
//
// IMPORTANT: actual Redis key names depend on your rpclpy KnowledgeManager
// configuration. Adjust the `keys` mappings in screw_detection_maple_input.json5
// to match whatever keys your system writes.
// ===========================================================================

// ---------------------------------------------------------------------
// IN DECLARATIONS — pub/sub events
// ---------------------------------------------------------------------

in t: Float    // monitor clock in seconds — publish via scripts/heartbeat_t.sh

in sensor_data_received: Struct<uid: Str, timestamp: Str, ...>
in observation_recorded:  Struct<uid: Str, timestamp: Str, ...>
in detection_completed:   Struct<uid: Str, timestamp: Str, ...>
in anomaly_detected:      Struct<uid: Str, timestamp: Str, ...>
in plan_generated:        Struct<uid: Str, timestamp: Str, ...>
in plan_validated:        Struct<uid: Str, timestamp: Str, ...>
in plan_rejected:         Struct<uid: Str, timestamp: Str, ...>
in plan_executed:         Struct<uid: Str, timestamp: Str, ...>

// ---------------------------------------------------------------------
// IN DECLARATIONS — knowledge state (Redis keys via redis-knowledge source)
// ---------------------------------------------------------------------

in frame_ref:             Struct<brightness: Float, ...>
in entropy_history:       Struct<values: List<Float>, ...>
in running_avg_entropy:   Struct<value: Float, ...>
in in_planning:           Struct<in_planning: Bool, ...>
in replanning_counter:    Struct<count: Int, ...>
in active_model:          Struct<model_id: Int, ...>
in candidate_model:       Struct<model_id: Int, ...>
in legit_result:          Struct<is_legit: Bool, candidate_model_id: Int, candidate_avg_entropy: Float, current_avg_entropy: Float, ...>
in action_command:        Struct<model_id: Int, ...>

// ---------------------------------------------------------------------
// AUX — boolean pulse: true only on the tick when a new uid arrives
// ---------------------------------------------------------------------

aux sensor_data_received_fired: Bool
aux observation_recorded_fired: Bool
aux detection_completed_fired:  Bool
aux anomaly_detected_fired:     Bool
aux plan_generated_fired:       Bool
aux plan_validated_fired:       Bool
aux plan_rejected_fired:        Bool
aux plan_executed_fired:        Bool

// ---------------------------------------------------------------------
// OUT DECLARATIONS
// ---------------------------------------------------------------------

// ---- parameters (keep in sync with Adaptation_Config in config.yaml) ----
out entropy_window_size:     Int
out entropy_threshold:       Float
out max_replans:             Int
out min_model_id:            Int
out max_model_id:            Int
out capture_deadline:        Float
out detection_deadline:      Float
out plan_deadline:           Float
out legit_deadline:          Float
out execute_deadline:        Float
out episode_deadline:        Float
out anomaly_grace:           Float
out stability_window:        Float
out brightness_min:          Float
out brightness_max:          Float
out consistency_tolerance:   Float
out sentinel_past_t:         Float

// ---- episode state machine ----
out phase:           Int
out phase_entered_t: Float
out episode_start_t: Float

// ---- P1 loop liveness ----
out awaiting_capture:    Bool
out sensor_t:            Float
out v_capture_timeout:   Bool
out awaiting_detection:  Bool
out observation_t:       Float
out v_detection_timeout: Bool

// ---- P2 entropy window analysis ----
out entropy_window_len:           Int
out entropy_window_len_f:         Float
out entropy_window_sum:           Float
out entropy_window_mean:          Float
out entropy_window_out_of_range:  Bool
out v_window_overflow:            Bool
out v_entropy_range:              Bool
out v_avg_range:                  Bool
out v_avg_mismatch:               Bool

// ---- P3 sensor brightness (warning) ----
out w_brightness_range: Bool

// ---- P4 anomaly soundness ----
out v_anomaly_unsound: Bool

// ---- P5 missed anomaly ----
out degraded:          Bool
out degraded_since:    Float
out v_missed_anomaly:  Bool

// ---- P6 protocol conformance ----
out v_overlapping_anomaly:     Bool
out v_unsolicited_plan:        Bool
out v_unsolicited_verdict:     Bool
out v_unlegitimated_execution: Bool

// ---- P7 per-step deadlines ----
out v_plan_timeout:    Bool
out v_legit_timeout:   Bool
out v_execute_timeout: Bool

// ---- P8 whole-episode bound ----
out v_episode_timeout: Bool

// ---- P9 candidate validity ----
out v_candidate_unknown:   Bool
out v_candidate_self_swap: Bool

// ---- P10 legitimation consistency ----
out legit_rule_accepts:      Bool
out v_unjustified_accept:    Bool
out v_unjustified_reject:    Bool
out v_verdict_flag_mismatch: Bool

// ---- P11 replan budget ----
out rejections:      Int
out v_replan_budget: Bool
out v_counter_leak:  Bool

// ---- P12 execute consistency ----
out v_execute_mismatch: Bool

// ---- P13 post-swap reset ----
out v_post_reset: Bool

// ---- P14 adaptation effectiveness ----
out assessing_effect:        Bool
out v_ineffective_adaptation: Bool

// ---- P15 swap rate and ping-pong ----
out swap1_t:    Float
out swap2_t:    Float
out swap3_t:    Float
out v_thrashing: Bool
out model1:     Int
out model2:     Int
out v_ping_pong: Bool

// ---- aggregated verdicts ----
out violation: Bool
out warning:   Bool

// ---------------------------------------------------------------------
// DEFINITIONS
// ---------------------------------------------------------------------

// ---- parameters ----
entropy_window_size   = 10
entropy_threshold     = 0.35
max_replans           = 3
min_model_id          = 1
max_model_id          = 4
capture_deadline      = 5.0
detection_deadline    = 20.0
plan_deadline         = 10.0
legit_deadline        = 60.0
execute_deadline      = 10.0
episode_deadline      = 120.0
anomaly_grace         = 10.0
stability_window      = 600.0
brightness_min        = 5.0
brightness_max        = 250.0
consistency_tolerance = 0.000001
sentinel_past_t       = -1000000000.0

// ---- pulse derivation ----
// A uid change on a channel means a new event fired this tick.
// default(..., false) guards the first tick when no prior value exists.
sensor_data_received_fired = default(!(sensor_data_received.uid == default(sensor_data_received[1].uid, "")), false)
observation_recorded_fired = default(!(observation_recorded.uid  == default(observation_recorded[1].uid,  "")), false)
detection_completed_fired  = default(!(detection_completed.uid   == default(detection_completed[1].uid,   "")), false)
anomaly_detected_fired     = default(!(anomaly_detected.uid      == default(anomaly_detected[1].uid,      "")), false)
plan_generated_fired       = default(!(plan_generated.uid        == default(plan_generated[1].uid,        "")), false)
plan_validated_fired       = default(!(plan_validated.uid        == default(plan_validated[1].uid,        "")), false)
plan_rejected_fired        = default(!(plan_rejected.uid         == default(plan_rejected[1].uid,         "")), false)
plan_executed_fired        = default(!(plan_executed.uid         == default(plan_executed[1].uid,         "")), false)

// ---- entropy window arithmetic (P2, P4, P5, P14) ----
entropy_window_len          = List.fold(\acc: Int,   e: Float -> acc + 1,   0,   entropy_history.values)
entropy_window_len_f        = List.fold(\acc: Float, e: Float -> acc + 1.0, 0.0, entropy_history.values)
entropy_window_sum          = List.fold(\acc: Float, e: Float -> acc + e,   0.0, entropy_history.values)
entropy_window_mean         = if entropy_window_len_f == 0.0 then 0.0 else entropy_window_sum / entropy_window_len_f
entropy_window_out_of_range = List.fold(\acc: Bool,  e: Float -> acc || e < 0.0 || e > 1.0, false, entropy_history.values)

// ---- episode state machine ----
// Includes the silent-abort fallback via in_planning knowledge (the gap
// that existed in the events-only spec is now closed).
phase = if anomaly_detected_fired then 1
        else if plan_generated_fired then 2
        else if plan_rejected_fired then 1
        else if plan_validated_fired then 3
        else if plan_executed_fired then 0
        else if (default(phase[1], 0) == 1 || default(phase[1], 0) == 2) && !in_planning.in_planning then 0
        else default(phase[1], 0)

phase_entered_t = if !(phase == default(phase[1], 0)) then t else default(phase_entered_t[1], 0.0)

episode_start_t = if anomaly_detected_fired then t else default(episode_start_t[1], 0.0)

// ---- P1 ----
awaiting_capture = if sensor_data_received_fired then true
                   else if observation_recorded_fired then false
                   else default(awaiting_capture[1], false)

sensor_t = if sensor_data_received_fired then t else default(sensor_t[1], 0.0)

v_capture_timeout = awaiting_capture && (t - sensor_t) > capture_deadline

awaiting_detection = if observation_recorded_fired then true
                     else if detection_completed_fired then false
                     else default(awaiting_detection[1], false)

observation_t = if observation_recorded_fired then t else default(observation_t[1], 0.0)

v_detection_timeout = awaiting_detection && (t - observation_t) > detection_deadline

// ---- P2 ----
v_window_overflow = entropy_window_len > entropy_window_size
v_entropy_range   = entropy_window_out_of_range
v_avg_range       = running_avg_entropy.value > 1.0
v_avg_mismatch    = entropy_window_len > 0
                 && running_avg_entropy.value >= 0.0
                 && (entropy_window_mean - running_avg_entropy.value > consistency_tolerance
                     || running_avg_entropy.value - entropy_window_mean > consistency_tolerance)

// ---- P3 ----
w_brightness_range = observation_recorded_fired
                  && (frame_ref.brightness < brightness_min || frame_ref.brightness > brightness_max)

// ---- P4 ----
v_anomaly_unsound = anomaly_detected_fired
                 && !(entropy_window_len >= entropy_window_size
                      && running_avg_entropy.value > entropy_threshold)

// ---- P5 ----
degraded = entropy_window_len >= entropy_window_size
        && running_avg_entropy.value > entropy_threshold
        && !in_planning.in_planning

degraded_since = if !degraded then -1.0
                 else if default(degraded_since[1], -1.0) < 0.0 then t
                 else default(degraded_since[1], -1.0)

v_missed_anomaly = degraded_since >= 0.0 && (t - degraded_since) > anomaly_grace

// ---- P6 ----
v_overlapping_anomaly     = anomaly_detected_fired && !(default(phase[1], 0) == 0)
v_unsolicited_plan        = plan_generated_fired   && !(default(phase[1], 0) == 1)
v_unsolicited_verdict     = (plan_validated_fired || plan_rejected_fired) && !(default(phase[1], 0) == 2)
v_unlegitimated_execution = plan_executed_fired    && !(default(phase[1], 0) == 3)

// ---- P7 ----
v_plan_timeout    = phase == 1 && (t - phase_entered_t) > plan_deadline
v_legit_timeout   = phase == 2 && (t - phase_entered_t) > legit_deadline
v_execute_timeout = phase == 3 && (t - phase_entered_t) > execute_deadline

// ---- P8 ----
v_episode_timeout = !(phase == 0) && (t - episode_start_t) > episode_deadline

// ---- P9 ----
v_candidate_unknown   = plan_generated_fired
                     && (candidate_model.model_id < min_model_id || candidate_model.model_id > max_model_id)
v_candidate_self_swap = plan_generated_fired && candidate_model.model_id == active_model.model_id

// ---- P10 ----
legit_rule_accepts   = legit_result.candidate_avg_entropy >= 0.0
                    && (legit_result.candidate_avg_entropy < legit_result.current_avg_entropy
                        || legit_result.candidate_avg_entropy < entropy_threshold)

v_unjustified_accept    = plan_validated_fired && !legit_rule_accepts
v_unjustified_reject    = plan_rejected_fired  && legit_rule_accepts
v_verdict_flag_mismatch = (plan_validated_fired && !legit_result.is_legit)
                       || (plan_rejected_fired  &&  legit_result.is_legit)

// ---- P11 ----
rejections = if anomaly_detected_fired then 0
             else if plan_rejected_fired then default(rejections[1], 0) + 1
             else default(rejections[1], 0)

v_replan_budget = plan_rejected_fired && rejections > max_replans
v_counter_leak  = anomaly_detected_fired && !(replanning_counter.count == 0)

// ---- P12 ----
v_execute_mismatch = plan_executed_fired
                  && !(legit_result.is_legit
                       && action_command.model_id == legit_result.candidate_model_id
                       && action_command.model_id == active_model.model_id)

// ---- P13 ----
v_post_reset = plan_executed_fired
            && (!(entropy_window_len == 0) || in_planning.in_planning || !(replanning_counter.count == 0))

// ---- P14 ----
assessing_effect = if plan_executed_fired then true
                   else if default(assessing_effect[1], false) && entropy_window_len >= entropy_window_size then false
                   else default(assessing_effect[1], false)

v_ineffective_adaptation = default(assessing_effect[1], false)
                        && entropy_window_len >= entropy_window_size
                        && running_avg_entropy.value > entropy_threshold

// ---- P15 ----
swap1_t = if plan_executed_fired then t else default(swap1_t[1], sentinel_past_t)
swap2_t = if plan_executed_fired then default(swap1_t[1], sentinel_past_t) else default(swap2_t[1], sentinel_past_t)
swap3_t = if plan_executed_fired then default(swap2_t[1], sentinel_past_t) else default(swap3_t[1], sentinel_past_t)

v_thrashing = plan_executed_fired && (t - swap3_t) < stability_window

model1 = if plan_executed_fired then active_model.model_id else default(model1[1], -1)
model2 = if plan_executed_fired then default(model1[1], -1) else default(model2[1], -1)

v_ping_pong = plan_executed_fired
           && default(model2[1], -1) == active_model.model_id
           && !(default(model1[1], -1) == active_model.model_id)
           && !(default(model2[1], -1) == -1)
           && (t - default(swap2_t[1], sentinel_past_t)) < stability_window

// ---- aggregated verdicts ----
violation = v_capture_timeout || v_detection_timeout
         || v_window_overflow || v_entropy_range || v_avg_range || v_avg_mismatch
         || v_anomaly_unsound || v_missed_anomaly
         || v_overlapping_anomaly || v_unsolicited_plan || v_unsolicited_verdict || v_unlegitimated_execution
         || v_plan_timeout || v_legit_timeout || v_execute_timeout
         || v_episode_timeout
         || v_candidate_unknown || v_candidate_self_swap
         || v_unjustified_accept || v_unjustified_reject || v_verdict_flag_mismatch
         || v_replan_budget || v_counter_leak
         || v_execute_mismatch || v_post_reset
         || v_ineffective_adaptation
         || v_thrashing || v_ping_pong

warning = w_brightness_range
